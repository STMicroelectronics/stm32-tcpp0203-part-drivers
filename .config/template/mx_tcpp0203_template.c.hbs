/**
  * @brief initialize the IO layer.
  * @param  pio      pointer to the part IO structure.
  * @retval error status.
  */
int32_t tcpp0203_io_init(tcpp0203_io_t *pio)
{
  /* Part Status */
  int ret = 0;

  switch (pio->id)
  {
{{#each @root.tcpp0203_instances}}
{{assign 'ctx' (@root.SWConfigurationAPI.getSwInstanceConfiguration this)~}}
{{#with @root.ctx}}
    case TCPP0203_{{@index}}:
{{#if (eq info.interface 'ADC_I2C_EXTI')}}
      pio->phadc        = TCPP0203_{{@index}}_ADC_GETHANDLE();
      pio->phi2c        = TCPP0203_{{@index}}_I2C_GETHANDLE();
      pio->addr         = (TCPP0203_{{@index}}_ADDRESS << 1);
      pio->enb_port     = TCPP0203_{{@index}}_ENB_GPIO_PORT;
      pio->enb_pin      = TCPP0203_{{@index}}_ENB_PIN;
      pio->active_state = TCPP0203_{{@index}}_ENB_ACTIVE_STATE;
      pio->phexti       = TCPP0203_{{@index}}_EXTI_GETHANDLE();
      pio->irq_line     = TCPP0203_{{@index}}_IRQ_LINE;
      pio->Ra           = TCPP0203_{{@index}}_VBUS_RA;
      pio->Rb           = TCPP0203_{{@index}}_VBUS_RB;
      pio->Rs           = TCPP0203_{{@index}}_IANA_ISENSE_RS;
      pio->Vdd          = TCPP0203_{{@index}}_VDD;

{{/if}}
      break;

{{/with}}
{{/each}}
    default:
      /* Error -- Unknown ID */
      ret = -1;
      break;
  }

  return ret;
}

